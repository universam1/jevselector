  },
  "bugs": {
    "url": "https://github.com/universam1/jevselector/issues"
  },
  "keywords": [
    "opencode",
    "opencode-plugin",
    "jev",
    "typesafe",
    "typesafe-ai",
    "context",
    "context-window",
    "skills",
    "mcp",
    "tokens",
    "token-optimization"
  ],
  "exports": {
    ".": {
      "import": "./src/index.ts",
